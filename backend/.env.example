# =============================================================================
# Shopno Jatra Backend — Environment Variables Template
# Copy this file to .env and fill in real values. NEVER commit .env.
# =============================================================================

# --- Application ---
ENVIRONMENT=production
DEBUG=false

# --- Database (PostgreSQL) ---
POSTGRES_USER=postgres
POSTGRES_PASSWORD=CHANGE_ME_strong_password_here
POSTGRES_DB=shopnojatra
DATABASE_URL=postgresql+asyncpg://${POSTGRES_USER}:${POSTGRES_PASSWORD}@postgres:5432/${POSTGRES_DB}
DATABASE_REPLICA_URLS=postgresql+asyncpg://${POSTGRES_USER}:${POSTGRES_PASSWORD}@pgbouncer_replica:6433/${POSTGRES_DB}

# --- PgBouncer DB Role Passwords ---
PGBOUNCER_POSTGRES_PASSWORD=CHANGE_ME_pgbouncer_postgres_pw
PGBOUNCER_SEARCH_PASSWORD=CHANGE_ME_search_readonly_pw
PGBOUNCER_BOOKING_PASSWORD=CHANGE_ME_booking_tx_pw

# --- Redis ---
REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=redis://redis:6379/1
CELERY_RESULT_BACKEND=redis://redis:6379/2

# --- Supabase ---
SUPABASE_URL=https://<your-project-ref>.supabase.co
SUPABASE_JWT_SECRET=CHANGE_ME_supabase_jwt_secret_min_32_chars

# --- Payment Webhook Secrets ---
BKASH_WEBHOOK_SECRET=CHANGE_ME_bkash_hmac_secret
NAGAD_WEBHOOK_SECRET=CHANGE_ME_nagad_hmac_secret
ROCKET_WEBHOOK_SECRET=CHANGE_ME_rocket_hmac_secret
STRIPE_WEBHOOK_SECRET=whsec_CHANGE_ME
CARD_WEBHOOK_SECRET=CHANGE_ME_card_hmac_secret
