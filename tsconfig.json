{
  "extends": "expo/tsconfig.base",
  "compilerOptions": {
    "strict": true,
    "baseUrl": ".",
    "paths": {
      "@/*": [
        "src/*"
      ],
      "@shopnojatra/shared": [
        "packages/shared/src/index.ts"
      ],
      "@shopnojatra/shared/*": [
        "packages/shared/src/*"
      ]
    }
  },
  "include": [
    "app",
    "src",
    "packages",
    "nativewind-env.d.ts",
    ".expo/types/**/*.ts",
    "expo-env.d.ts"
  ],
  "exclude": [
    "node_modules",
    "**/__tests__/**",
    "**/*.test.ts",
    "**/*.test.tsx",
    "AGEN/**",
    "hotel/**"
  ]
}
